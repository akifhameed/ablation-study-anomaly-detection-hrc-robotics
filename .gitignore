# ---------- The dataset ----------
# 6.9 GB, publicly available from Zenodo.
# Anyone can download it; the README says where.
stochastic_PnP/

# ---------- Generated data ----------
# combined_dataset.csv is 2.9 GB and is rebuilt by combined_dataset.ipynb.
# GitHub rejects any file over 100 MB, so this must never be staged.
*.csv

# ---------- The virtual environment ----------
# Thousands of files, machine-specific, and recreatable from requirements.txt.
.venv/

# ---------- My working documents ----------
# Draft write-ups, kept locally until submission.
*.docx
~$*.docx
*.tmp
~WRL*.tmp

# ---------- Python and Jupyter clutter ----------
__pycache__/
*.pyc
.ipynb_checkpoints/

# ---------- Editor and operating system ----------
.vscode/
.cursor/
.DS_Store
Thumbs.db

# ---------- Experiment results ----------
# The line above hides the multi-gigabyte generated datasets, but the small
# result tables inside results/ are the findings and must be kept.
!results/**/*.csv
# The ablation study writes to results_ablation, so rescue its tables too.
!results_ablation/**/*.csv

# ---------- Raw anomaly scores ----------
# 5 seeds x 246,151 test rows per configuration, about 5 MB each. Regenerable
# by re-running the notebook, so they stay local.
*.npy

# Any results folder (results, results_ablation, results_deep, and future ones).
# This makes the two specific rules above redundant but harmless.
!results*/**/*.csv
